{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*", 
  "RestAPIHost": "https://$[localhost]:8051",
  "GrpcAPIHost": "https://$[localhost]:8071",
  "SettingsAPIHost": "https://$[localhost]:8201",
  "SignalRImportUrl": "https://$[localhost]:8101/import",
  "SignalREventsUrl": "https://$[localhost]:8101/events",
  "RabbitMqServiceOptions": {
    "HostName": "$[localhost]",
    "Port": 15672
  },
  "RabbitMqQueueOptions": {
    "Name": "shop.import.queue"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithThreadName" ],
    "Properties": {
      "Application": "Alchemist.ImportWorkerService"
    }
  }
}
