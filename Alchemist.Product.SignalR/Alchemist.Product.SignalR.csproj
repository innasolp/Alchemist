      <HintPath>..\Libs\Http\ErrorHandling\Http.ErrorHandling.dll</HintPath>
    </Reference>
    <Reference Include="Http.Info">
      <HintPath>..\Libs\Http\Info\Http.Info.dll</HintPath>
