{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    },
    "EndPoints": {
      "Http": {
        "Url": "http://+:8120"
      },
      "Https": {
        "Url": "https://+:8121"
      }
    }
  },
  "RestAPIHost": "https://$[localhost]:8051/",
  "GrpcAPIHost": "https://$[localhost]:8071",
  "SignalRUrl": "https://$[localhost]:8101/import",
  "RabbitMqServiceOptions": {
    "HostName": "$[localhost]",
    "Port": 15672
  },
  "RabbitMqQueueOptions": {
    "Name": "shop.import.queue"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithThreadName" ],
    "Properties": {
      "Application": "Alchemic.Shop.ImportWorkerService"
    }
  }
}
