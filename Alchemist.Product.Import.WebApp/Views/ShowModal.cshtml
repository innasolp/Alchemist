@model ShowModalModel

<div class="modal fade @Model.ModalDivClass">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <a href="#" class="close" id="@Model.ModalCloseBtn">&times;</a>
            </div>
            <div class="modal-body @Model.ModalBodyDivClass">
            </div>
        </div>
    </div>
</div>