@using System.Text.Json
@using Alchemist.Product.Import.Model
@model ProductShopSettingsModel

<div class="form-group">
    <label asp-for="ProductUrlFormat" class="control-label"></label>
    <input asp-for="ProductUrlFormat" class="form-control form-input" value="@Model.ProductUrlFormat" />
    <span asp-validation-for="ProductUrlFormat" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="CategoryUrlFormat" class="control-label"></label>
    <input asp-for="CategoryUrlFormat" class="form-control form-input" value="@Model.CategoryUrlFormat" />
    <span asp-validation-for="CategoryUrlFormat" class="text-danger"></span>
</div>

<div class="form-group-table">
    <ul class="table-ul" id="rootCategoriesUl">
        <li class="table-ul header">
            <div class="flex">
                <div class="table_header">Item ID</div>
                <div class="table_header">Url</div>
                <div></div>
            </div>
        </li>
        @foreach (var category in (Model.RootCategories ?? []))
        {
            <li id="rootcategory_li_@(category.Guid)" class="table-ul rootcategory_li">
                <div class="flex rootCategoryRow">
                    <div class="table_cell item" >@category.Item</div>
                    <div class="table_cell url">@category.Url</div>
                    <input type="hidden" class="guid" value="@category.Guid"/>
                    <div>
                        <button type="button" class="editRootCategory" onclick="showRootCategory(@JsonSerializer.Serialize(category, new JsonSerializerOptions
                                                                       {
                                                                           PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
                                                                           WriteIndented = true
                                                                       }))">
                            <i class='fa fa-edit' style='font-size:18px'></i>
                        </button>
                    </div>                    
                </div>
            </li>
        }
        <li class="table-ul">
            <div>
                <a id="addRootCategory"
                   onclick="showRootCategory({shopSettingsGuid:'@Model.Guid'})">Add category</a>
            </div>         
        </li>
        <li class="table-ul">
            <div class="modal fade" id="divRootCategoryModal" role="dialog">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                        <div class="modal-body" id="categoryModalBodyDiv">
                        </div>
                    </div>
                </div>
            </div>
        </li>
    </ul>
</div>

