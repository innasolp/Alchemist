@using System.Text.Json
@using Alchemist.Product.Import.Model
@using Alchemist.Product.Interfaces
@model ShopSettingsModel

@functions {

    public object GetServiceData() => JsonSerializer.Serialize(new { shopGuid = Model.ShopGuid, shopSettingsId = Model.Id, shopSettingsGuid = Model.Guid });
    public string GetSubmitUrl() => Model.ShopSettingType == ShopSettingType.Product ? "/ShopSettings/SaveProductShopSettingsToDb" : "/ShopSettings/SaveCategoryShopSettingsToDb";
    public string GetServiceUploadOnChange(string serviceName) => "setServiceSettingsFromJson($('#settingsForm'), this.name, '" + Model.ShopGuid + "', '" + Model.Guid + "', '" + serviceName + "', (data)=>{setValIfValid('#" + serviceName + "', data.serviceTypeName); " + UploadFromFileModel.onSuccess + " })";
    public string GetUploadServiceValueOnChange(string serviceName) => "setServiceSettingsFromJson($('#settingsForm'), this.name, '" + Model.ShopGuid + "', '" + Model.Guid + "', '" + serviceName + "', (data)=>{" + UploadFromFileModel.onSuccess + " })";
    public string GetUploadShopSettingsOnChange(string id) => "setShopSettingsFromJson($('#loadSettingsFromJsonForm'), '" + id + "', '" + Model.ShopGuid + "', " + (int)Model.ShopSettingType + ")"; 
 }

<div class="row">
    <div class="col-md-8">
        <div class="modal fade" id="divModal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <a href="#" class="close" data-bs-dismiss="modal">&times;</a>                       
                    </div>
                    <div class="modal-body" id="modalBodyDiv">
                    </div>
                </div>
            </div>
        </div>
        <form id="loadSettingsFromJsonForm">
            <div class="form-group">                
                @await Html.PartialAsync($"~/Views/UploadFromFile.cshtml", new UploadFromFileModel { Id = "loadShopSettingsFromJson", OnChange = GetUploadShopSettingsOnChange("loadShopSettingsFromJson"), FileName = Model.FileName })
            </div>
        </form>
        <form id="settingsForm">
            <input type="hidden" name="ShopGuid" value="@Model.ShopGuid" />
            <input type="hidden" name="ShopSettingsGuid" value="@Model.Guid" />
            <input type="hidden" name="Tab" value="@((int)Model.Tab)" />
            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="ShopSettingType" value="@((int)Model.ShopSettingType)" />
            <input type="hidden" name="SelectedSettingsTab" value="@((int)Model.ShopSettingType)" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control form-input" value="@Model.Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>           
            <div class="form-group">
                <label asp-for="Url" class="control-label"></label>
                <input asp-for="Url" class="form-control form-input" />
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImportService" class="control-label"></label>
                <div class="flex">
                    <div>
                        <input class="form-control form-input" id="ImportService" readonly="readonly" value="@Model.ImportService?.ServiceTypeName" />
                        <span asp-validation-for="ImportService" class="text-danger"></span>
                    </div>
                    <div class="flex control-group">
                        <div>
                            <button onclick="showServiceSettingsModal('/ShopSettings/ImportServiceSettings', @GetServiceData(), (result)=>{ if(result) clearFileNameFromUploadControl('importServiceJson'); }  )"
                                    class="btn btn-primary btn-sm form-button">
                                Set
                            </button>
                        </div>
                        @await Html.PartialAsync($"~/Views/UploadFromFile.cshtml", new UploadFromFileModel { Id = "importServiceJson", OnChange = GetServiceUploadOnChange("ImportService"), FileName = Model.ImportService?.FileName })
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="BrowserDataLoader" class="control-label"></label>
                <div class="flex">
                    <div>
                        <input class="form-control form-input" id="BrowserDataLoader" readonly="readonly" value="@Model.BrowserDataLoader?.ServiceTypeName" />
                        <span asp-validation-for="BrowserDataLoader" class="text-danger"></span>
                    </div>
                    <div class="flex control-group">
                        <button onclick="showServiceSettingsModal('/ShopSettings/BrowserDataLoaderSettings', @GetServiceData(), (result)=>{ if(result) clearFileNameFromUploadControl('browserDataLoaderJson'); }  )"
                                class="btn btn-primary btn-sm form-button">
                            Set
                        </button>
                        @await Html.PartialAsync($"~/Views/UploadFromFile.cshtml", new UploadFromFileModel { Id = "browserDataLoaderJson", OnChange = GetServiceUploadOnChange("BrowserDataLoader"), FileName = Model.BrowserDataLoader?.FileName })
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="RequestHeaders" class="control-label"></label>
                <span asp-validation-for="RequestHeaders" class="text-danger"></span>
                @await Html.PartialAsync($"~/Views/UploadFromFile.cshtml", new UploadFromFileModel { Id = "requestHeadersJson", OnChange = GetUploadServiceValueOnChange("RequestHeaders"), FileName = Model.RequestHeaders?.FileName })
            </div>
            <div class="form-group">
                <label asp-for="WebLoader" class="control-label"></label>
                <div class="flex">
                    <div>
                        <input class="form-control form-input" id="WebLoader" readonly="readonly" value="@Model.WebLoader?.ServiceTypeName" />
                        <span asp-validation-for="WebLoader" class="text-danger"></span>
                    </div>
                    <div class="flex  control-group">
                        <button onclick="showServiceSettingsModal('/ShopSettings/WebLoaderSettings', @GetServiceData(), (result)=>{ if(result) clearFileNameFromUploadControl('webLoaderJson'); } )"
                                class="btn btn-primary btn-sm form-button">
                            Set
                        </button>
                        @await Html.PartialAsync($"~/Views/UploadFromFile.cshtml", new UploadFromFileModel { Id = "webLoaderJson", OnChange = GetServiceUploadOnChange("WebLoader"), FileName = Model.WebLoader?.FileName })
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary form-button"
                        onclick="this.disabled=true;save('#settingsForm','@GetSubmitUrl()', getFormData($('#settingsForm')), (result)=> { this.disabled = false;}, (error)=>{this.disabled = false;});">
                    Save
                </button>
            </div>

        </form>
    </div>
</div>
