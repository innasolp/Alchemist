@using System.Text.Json
@model Alchemist.Product.Import.WebApp.Models.ShopSettingsModel

@functions {

    public object GetServiceData() => JsonSerializer.Serialize(new { shopId = Model.ShopId, shopSettingsId = Model.Id});
}

<div class="row">
    <div class="col-md-4">
        <div class="modal fade" id="divModal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <a href="#" class="close" data-bs-dismiss="modal">&times;</a>
                        <h3 class="modal-title text-bg-success" id="heading">Insert record</h3>
                    </div>
                    <div class="modal-body" id="modalBodyDiv">
                    </div>
                </div>
            </div>
        </div>
        <form id="loadSettingsFromJsonForm">
            <div class="form-group">               
                <label class="control-label">From json</label>
                <input type="file" class="btn btn-primary" id="loadShopSettingsFromJson" style="display:none"
                       name="loadShopSettingsFromJson"
                       onchange="setShopSettingsFromJson($('#loadSettingsFromJsonForm'), this.name, @Model.ShopId, @((int)Model.ShopSettingType))" />
                <button type="button" class="btn btn-primary"
                        onclick="$('#loadShopSettingsFromJson')[0].click();">
                    Upload
                </button>
            </div>
        </form>
        <form id="settingsForm">
            <input type="hidden" name="ShopId" value="@Model.ShopId" />
            <input type="hidden" name="Tab" value="@((int)Model.Tab)" />
            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden" name="ShopSettingType" value="@((int)Model.ShopSettingType)" />
            <input type="hidden" name="SelectedSettingsTab" value="@((int)Model.ShopSettingType)" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" value="@Model.Name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Caption" class="control-label"></label>
                <input asp-for="Caption" class="form-control" value="@Model.Caption" />
                    <span asp-validation-for="Caption" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Url" class="control-label"></label>
                    <input asp-for="Url" class="form-control" />
                    <span asp-validation-for="Url" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ImportService" class="control-label"></label>
                    <input class="form-control" id="ImportService" readonly="readonly" value="@Model.ImportService?.ServiceTypeName" />
                    <span asp-validation-for="ImportService" class="text-danger"></span>
                    <button onclick="showServiceSettingsModel('/Home/ImportServiceSettings', @GetServiceData())"
                        class="btn btn-primary btn-sm">
                        Set
                    </button>
                    <input type="file" class="btn btn-primary" id="importServiceJson" name="importServiceJson"
                       onchange="setServiceSettingsFromJson($('#settingsForm'), this.name, @Model.ShopId, @((int)Model.ShopSettingType), 'ImportService', (data)=>{setValIfValid('#ImportService', data.serviceTypeName);})" />
                </div>
                <div class="form-group">
                    <label asp-for="BrowserDataLoader" class="control-label"></label>
                    <input class="form-control" id="BrowserDataLoader" readonly="readonly" value="@Model.BrowserDataLoader?.ServiceTypeName" />
                    <span asp-validation-for="BrowserDataLoader" class="text-danger"></span>
                    <button onclick="showServiceSettingsModel('/Home/BrowserDataLoaderSettings', @GetServiceData() )"
                            class="btn btn-primary btn-sm">
                        Set
                    </button>
                    <input type="file" class="btn btn-primary" id="browserDataLoaderJson" name="browserDataLoaderJson"
                       onchange="setServiceSettingsFromJson($('#settingsForm'), this.name, @Model.ShopId, @((int)Model.ShopSettingType), 'BrowserDataLoader', (data)=>{setValIfValid('#BrowserDataLoader', data.serviceTypeName);})" />
                </div>
                <div class="form-group">
                    <label asp-for="RequestHeaders" class="control-label"></label>
                    <input type="hidden" asp-for="RequestHeaders" id="requestHeadersHidden" />
                    <span asp-validation-for="RequestHeaders" class="text-danger"></span>
                    <input type="file" class="btn btn-primary" id="jsonFile" name="jsonFile"
                       onchange="postFormInputFile('/FileUpload/UploadJson', $('#settingsForm'), this.name, null, (data)=>{ setValIfValid('#requestHeadersHidden',data); })" />
                </div>
                <div class="form-group">
                    <label asp-for="WebLoader" class="control-label"></label>
                    <input class="form-control" id="WebLoader" readonly="readonly" value="@Model.WebLoader?.ServiceTypeName" />
                    <span asp-validation-for="WebLoader" class="text-danger"></span>
                    <button onclick="showServiceSettingsModel('/Home/WebLoaderSettings', @GetServiceData() )"
                            class="btn btn-primary btn-sm">
                        Set
                    </button>
                    <input type="file" class="btn btn-primary" id="webLoaderJson" name="webLoaderJson"
                       onchange="setServiceSettingsFromJson($('#settingsForm'), this.name, @Model.ShopId, @((int)Model.ShopSettingType), 'WebLoader', (data)=>{setValIfValid('#WebLoader', data.serviceTypeName);})" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary"
                            onclick="save('#settingsForm','/Home/SaveShopSettings', { 'shopId': '@Model.ShopId'} )">
                        Save
                    </button>
                </div>
            
        </form>
    </div>
</div>
