@using System.Text.Json
@model Alchemist.Product.Import.WebApp.Models.ShopSettingsModel

@functions {

    public object GetServiceData() => JsonSerializer.Serialize(new { shopId = Model.ShopId, shopSettingsId = Model.Id });
}

<h4>ShopSettingsModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="modal fade" id="divModal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <a href="#" class="close" data-bs-dismiss="modal">&times;</a>
                        <h3 class="modal-title text-bg-success" id="heading">Insert record</h3>
                    </div>
                    <div class="modal-body" id="modalBodyDiv">
                    </div>
                </div>
            </div>
        </div>
        <form id="settingsForm">
            <input type="hidden" name="ShopId" value="@Model.ShopId" />
            <input type="hidden" name="SettingsType" value="@Model.Type" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImportService" class="control-label"></label>
                <button onclick="ShowItemModal('Home/ImportServiceSettings', @GetServiceData())"
                        class="btn btn-primary btn-sm">
                    Set import service
                </button>
                <span asp-validation-for="ImportService" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BrowserDataLoader" class="control-label"></label>
                <button onclick="ShowItemModal('Home/BrowserDataLoaderSettings', @GetServiceData())"
                        class="btn btn-primary btn-sm">
                    Set browser dataloader
                </button>
                <span asp-validation-for="BrowserDataLoader" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RequestHeaders" class="control-label"></label>
                <input type="hidden" asp-for="RequestHeaders" id="requestHeadersHidden" />
                <span asp-validation-for="RequestHeaders" class="text-danger"></span>
                <input type="file" class="btn btn-primary" id="jsonFile" name="jsonFile"
                       onchange="postFormInputFile('/FileUpload/UploadJson', document.getElementById('settingsForm'), this.name, (data)=>{setJson(data,'requestHeadersHidden');})" />
            </div>
            <div class="form-group">
                <label asp-for="WebLoader" class="control-label"></label>
                <button onclick="ShowItemModal('Home/WebLoaderSettings', @GetServiceData())"
                        class="btn btn-primary btn-sm">
                    Set web loader
                </button>
                <span asp-validation-for="WebLoader" class="text-danger"></span>
            </div>
        </form>
    </div>
</div>
