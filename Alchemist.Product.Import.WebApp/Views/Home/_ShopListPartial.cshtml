@using Alchemist.Product.Import.Model.Infrastructure;

@model IEnumerable<Alchemist.Product.Import.Model.ShopModel>

@{
    var selectedTabViewName = (ViewData["Tab"] is TabType tabType) ? TabHelper.TabViewNames.FirstOrDefault(d => d.Key == tabType) : TabHelper.TabViewNames.FirstOrDefault();
 }

<ul class="left-menu-ul" id="shopsList">
    <li class="left-menu-ul">
        <a id="createNewShop"
           onclick="showShopModal('/Shop/New', null, (result)=>{ if(!result) return; tabChanged($('#settingsForm'), ()=>{$('#newShopForm')[0].submit(); });})">Новый</a>
    </li>

    @foreach (var shop in Model)
    {       
        <li id="shop_li_@(shop.Guid)" class="left-menu-ul">
            <div class="flex">
                <form name="itemShopForm" method="get" asp-action="Index" asp-controller="Home" asp-antiforgery="true"
                      asp-route-shopGuid="@shop.Guid"
                      asp-route-tab="@((int)selectedTabViewName.Key)">
                    <a onclick="tabChanged($('#settingsForm'), ()=>{this.parentElement.submit();});" style="width:250px">@shop.Name</a>                   
                    </form>
            </div>
        </li>        
    }
</ul>
