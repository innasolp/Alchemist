@using Alchemist.Product.Import.Model.Infrastructure
@using Alchemist.Product.Interfaces
@using Alchemist.Product.Import.Model
@using System.Text.Json
@model Alchemist.Product.Import.Model.ShopSettingTabsModel

@functions {
    public object GetServiceData(ShopSettingType shopSettingType) => JsonSerializer.Serialize(new { shopGuid = Model.ShopGuid, shopSettingType = (int)shopSettingType });
}

@{
    var selectedShopSettings = Model.GetShopSettingsByType(Model.SelectedSettingsTab);
}
<hr />
<div>
    <div class="menu" id="menuDiv">
        <div class="@CssHelper.GetAnchorMenuItemStyle(Model.SelectedSettingsTab, ShopSettingType.Product)">
            <a class="display-8  menu_header"
               onclick="saveShopSettings($('#settingsForm'),(data)=> postData('/ShopSettings/SetShopSettings', @GetServiceData(ShopSettingType.Product), (r)=> {if(r) location.reload(); }))">
                @ViewHelper.ShopSettingTypeNames[ShopSettingType.Product]
            </a>
        </div>
        <div class="@CssHelper.GetAnchorMenuItemStyle(Model.SelectedSettingsTab, ShopSettingType.Category)">
            <a class="display-8  menu_header"
               onclick="saveShopSettings($('#settingsForm'),(data)=> postData('/ShopSettings/SetShopSettings',  @GetServiceData(ShopSettingType.Category), (r)=> {if(r) location.reload(); }))">
                @ViewHelper.ShopSettingTypeNames[ShopSettingType.Category]
            </a>
        </div>
    </div>
    <div>
        @await Html.PartialAsync($"~/Views/Home/ShopSettings.cshtml", selectedShopSettings ?? new ProductShopSettingsModel())
    </div>
</div>

