@using Alchemist.Product.Import.Model.Infrastructure
@using Alchemist.Import.Settings.Interfaces
@using Alchemist.Product.Import.Model
@using System.Text.Json
@model ShopSettingTabsModel

@functions {
    public object GetServiceData(ShopSettingType shopSettingType) => JsonSerializer.Serialize(new { shopGuid = Model.ShopGuid, shopSettingType = (int)shopSettingType });

    public string AnchorOnClick(ShopSettingType shopSettingType)
    {
        return $"$(this).on('click', function()=>{{  redirectToShopSettings({GetServiceData(shopSettingType)}) }})";
    }
}

@{
    var selectedShopSettings = Model.GetShopSettingsByType(Model.SelectedSettingsTab);
}
<hr />
<div class="tabs">
    <div class="menu tabsMenuDiv">
        <div class="shopTab @CssHelper.GetAnchorMenuItemStyle(Model.SelectedSettingsTab, ShopSettingType.Product)">
            <a onload="@AnchorOnClick(ShopSettingType.Product)"
               onclick="redirectToShopSettings(@GetServiceData(ShopSettingType.Product),this.parentElement)"
            class="display-8  menu_header">@TabHelper.ShopSettingTypeNames[ShopSettingType.Product]</a>
        </div>
        <div class="shopTab @CssHelper.GetAnchorMenuItemStyle(Model.SelectedSettingsTab, ShopSettingType.Category)">
            <a onclick="redirectToShopSettings(@GetServiceData(ShopSettingType.Category), this.parentElement)"
                onload ="@AnchorOnClick(ShopSettingType.Category)" 
                class="display-8  menu_header">@TabHelper.ShopSettingTypeNames[ShopSettingType.Category]</a>
        </div>
    </div>
    <div class="shopSettingsPartialDiv">
        @await Html.PartialAsync($"~/Views/Home/ShopSettings.cshtml", selectedShopSettings)        
    </div>
</div>

