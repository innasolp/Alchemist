@model Alchemist.Product.Import.WebApp.Models.ServiceSettingsModel

<h4>ServiceSettingsModel</h4>
<hr />
<form id="modalForm">
    <input type="hidden" name="ShopId" value="@Model.ShopId" />
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="ShopSettingsId" value="@Model.ShopSettingsId" />
    <input type="hidden" name="Guid" value="@Model.Guid" />
    <div class="row">
        <div class="col-md-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div> 

            <div class="form-group">
                <label asp-for="JsonValue" class="control-label"></label>
                <input asp-for="JsonValue" class="form-control" />
                <span asp-validation-for="JsonValue" class="text-danger"></span>
                <button type="button" class="btn btn-primary" onclick="save()">Load data in json</button>
            </div>
             <div class="form-group">
                <label asp-for="ServiceTypeName" class="control-label"></label>
                <input asp-for="ServiceTypeName" class="form-control" />
                <span asp-validation-for="ServiceTypeName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImplementationTypeName" class="control-label"></label>
                <input asp-for="ImplementationTypeName" class="form-control" />
                <span asp-validation-for="ImplementationTypeName" class="text-danger"></span>
            </div><div class="form-group">
                <label asp-for="AssemblyPath" class="control-label"></label>
                <input asp-for="AssemblyPath" class="form-control" name="AssemblyPath" />
                <span  asp-validation-for="AssemblyPath" class="text-danger"></span>
            </div><div class="form-group">
                <label asp-for="ServiceProviderPath" class="control-label"></label>
                <input asp-for="ServiceProviderPath" class="form-control" />
                <span asp-validation-for="ServiceProviderPath" class="text-danger"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="save('Home/SaveImportServiceSettings', getFormData(document.getElementById('modalForm')), ()=>{closeItemModal();} )">Save</button>
            </div>
        </div>
    </div>
</form>


