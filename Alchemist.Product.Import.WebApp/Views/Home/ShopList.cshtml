@using Alchemist.Product.Import.Model
@using Alchemist.Product.Import.Model.Infrastructure;

@model IEnumerable<IShopModel>

@{
    var selectedTabViewName = (ViewData["Tab"] is TabType tabType) ? TabHelper.TabViewNames.FirstOrDefault(d => d.Key == tabType) : TabHelper.TabViewNames.FirstOrDefault();
 }

<div>
    <div class="left_menu">
        <h1 class="display-7 menu_item">Shops</h1>
    </div>
    <div class="left-menu-ul">
        <form id="newShopForm" name="newShopForm" method="get" action="/Home/Index/" asp-antiforgery="true">
            <input type="hidden" name="shopGuid" id="newShopGuid"  />
            <input type="hidden" name="tab" value="@((int)selectedTabViewName.Key)" />
        </form>
        @await Html.PartialAsync($"~/Views/ShowModal.cshtml", new ShowModalModel { ModalDivClass = "shopModal", ModalBodyDivClass = "shopModalBody", ModalCloseBtn = "shopCloseBtn" })        
    </div>
    <div class="shopListPartialDiv">        
        @await Html.PartialAsync($"~/Views/Home/_ShopListPartial.cshtml", Model)
    </div>
</div>