@using Alchemist.Product.Import.WebApp.Infrastructure;

@inject List<ShopModel> shops;
@inject IReadOnlyCollection<string> tabs;
@inject IDictionary<int, ShopImportModel> shopImports;

@{
    ViewData["Title"] = "Home Page";
    var shopId = ViewData["ShopId"] != null ? (int?)ViewData["ShopId"] : null;
    var selectedShop = shops.FirstOrDefault(s => s.Id == shopId) ?? shops.FirstOrDefault();
    var selectedTab = ViewData["Tab"] as string ?? tabs.FirstOrDefault();
    var selectedShopImport = selectedShop != null && shopImports.ContainsKey(selectedShop.Id) ? shopImports[selectedShop.Id] : null;
    var currentTabModel = TabFactory.GetSettings(selectedShopImport, selectedTab);
}

@functions
{   
    public string GetLiStyle(string item, string selectedItem) => "left-menu-ul" + (selectedItem == item ? " selected" : "");
    public string GetMenuItemStyle(string item, string selectedItem) => "menu_item" + (selectedItem == item ? " selected" : "");
}


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


<script>
       async function saveSettings(form)
       {
           var settingsForm = document.getElementById('settingsForm');
           var settingsFormData = new FormData(settingsForm);
           addFormDataJson(settingsFormData);
           var newFormData = getFormDataWithPrefix(settingsFormData, 'prevSettings');

           await  sendFormData(newFormData,'/', 'post', ()=>form.submit());
       }

</script>
}


<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>

    <div class="flex">

        <div>
            <div class="left_menu">
                <h1 class="display-7 menu_item">Shops</h1>
            </div>
            <ul class="left-menu-ul" id="shopsList">
                @foreach (var shop in shops)
                {
                    <form name="shopForm" method="post" asp-action="Index" asp-controller="Home" asp-antiforgery="true"
                          asp-route-shopId="@shop.Id"
                          asp-route-tab="@selectedTab">
                        <li class="@GetLiStyle(shop.Name,selectedShop.Name)">
                        <a onclick=" saveSettings(this.parentElement.parentElement);">@shop.Name</a>
                        </li>
                    </form>
                }
            </ul>
        </div>

        <div>
            <div class="menu" id="menuDiv">                
                @foreach (var tab in tabs)
                {
                    <div class="@GetMenuItemStyle(tab,selectedTab)">
                        <form method="post" asp-action="Index" asp-controller="Home" asp-antiforgery="true"
                              asp-route-shopId="@selectedShop.Id"
                              asp-route-tab="@tab">
                            <label class="display-7  menu_header" onclick="saveSettings(this.parentElement);">@tab</label>
                        </form>
                    </div>
                }
            </div>
             <div id="settingsDiv">                
                @await Html.PartialAsync(selectedTab, currentTabModel));
            </div>           
        </div>
    </div>

</div>
