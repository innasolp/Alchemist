@using Alchemist.Product.Import.Model.Infrastructure;

@model Alchemist.Product.Import.WebApp.Models.IndexViewModel

@{
    ViewData["Title"] = "Home Page";
    var shopGuid = Model.SelectedShopImport.ShopGuid;
    var selectedTabViewName = (ViewData["Tab"] is TabType tabType) ? ViewHelper.TabViewNames.FirstOrDefault(d => d.Key == tabType) : ViewHelper.TabViewNames.FirstOrDefault();
    var selectedTabName = (ViewData["Tab"] is TabType tabType2) ? ViewHelper.TabNames.FirstOrDefault(d => d.Key == tabType2) : ViewHelper.TabViewNames.FirstOrDefault();    
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }    

    <script src="~/js/fileUpload.js"></script>

    <script src="~/js/settings.js"></script>


}


<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>

    <div class="flex">

        <div>
            <div class="left_menu">
                <h1 class="display-7 menu_item">Shops</h1>
            </div>
            <ul class="left-menu-ul" id="shopsList">
                @foreach (var shop in Model.Shops)
                {
                    <form name="shopForm" method="get" asp-action="Index" asp-controller="Home" asp-antiforgery="true"
                          asp-route-shopGuid="@shop.Guid"
                          asp-route-tab="@((int)selectedTabViewName.Key)">
                    <li class="@CssHelper.GetLiStyle(shop.Name,Model.SelectedShopImport.Shop.Name)">
                        <a onclick="saveTab($('#settingsForm'), ()=>{this.parentElement.parentElement.submit();}); ">@shop.Name</a>
                    </li>
                    </form>
                }
            </ul>
        </div>

        <div>
            <div class="menu" id="menuDiv">
                @foreach (var tab in ViewHelper.TabNames)
                {
                    <div class="@CssHelper.GetMenuItemStyle(tab.Key,selectedTabName.Key)">
                        <form method="get" asp-action="Index" asp-controller="Home" asp-antiforgery="true"
                              asp-route-shopGuid="@Model.SelectedShopImport.ShopGuid"
                              asp-route-tab="@((int)tab.Key)">
                            <label class="display-7  menu_header" onclick="saveTab($('#settingsForm'), ()=>{ this.parentElement.submit();})">@tab.Value</label>
                        </form>
                    </div>
                }
            </div>
            <div id="settingsDiv">
                @await Html.PartialAsync($"~/Views/Home/{selectedTabViewName.Value}.cshtml", Model.SelectedTabModel);
            </div>
        </div>
    </div>

</div>
