@using Alchemist.Product.Import.Model.Infrastructure;
@using Alchemist.Product.Import.Model;

@model Alchemist.Product.Import.WebApp.Models.IndexViewModel

@{
    ViewData["Title"] = "Home Page";
    TabType tabType = Model.SelectedTabModel?.Tab ?? default(TabType);
    var selectedTabViewName = TabHelper.TabViewNames.FirstOrDefault(d => d.Key == tabType);    
    Guid? shopGuid = (ViewData["ShopGuid"] is Guid guid) ? guid : null;
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/fileUpload.js"></script>

    <script src="~/js/shop.js"></script>

    <script src="~/js/settings.js"></script>

    <script src="~/js/utils.js"></script>

    <script src="~/js/tabs.js"></script>

    <script>
        updateShops($('#shopListPartialDiv'), {'shopGuid': '@(shopGuid?.ToString() ?? "")', 'tab': @((int?)Model.SelectedTabModel?.Tab ?? 0), 'tabView' : '@selectedTabViewName.Value'  }, $('#settingsPartialDiv') );
    </script>
}

<div class="flex">
    <div>        
        @await Html.PartialAsync($"~/Views/Home/ShopList.cshtml", Model.Shops)
    </div>
    <div style="width:100%">
        <div class="menu" id="menuDiv">
           @await Html.PartialAsync($"~/Views/Home/_TabsMenuPartial.cshtml", Model?.SelectedTabModel ?? new ShopSettingTabsModel())
        </div>
        <div id="settingsPartialDiv">
            @await Html.PartialAsync($"~/Views/Home/{selectedTabViewName.Value}.cshtml", Model.SelectedTabModel ?? ModelHelper.CreateDefaultTabModel(tabType))
        </div>
    </div>
</div>

