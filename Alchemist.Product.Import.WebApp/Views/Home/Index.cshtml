@using Alchemist.Product.Import.WebApp.Infrastructure;

@inject List<ShopModel> shops;
@inject IDictionary<int, ShopImportModel> shopImports;

@{
    ViewData["Title"] = "Home Page";
    var shopId = ViewData["ShopId"] != null ? (int?)ViewData["ShopId"] : null;
    var selectedShop = shops.FirstOrDefault(s => s.Id == shopId) ?? shops.FirstOrDefault();
    var selectedTabView = (ViewData["Tab"] is TabType tabType) ? ModelHelper.TabViewNames.FirstOrDefault(d => d.Key == tabType) : ModelHelper.TabViewNames.FirstOrDefault();
    var selectedTabName = (ViewData["Tab"] is TabType tabType2) ? ModelHelper.TabNames.FirstOrDefault(d => d.Key == tabType2) : ModelHelper.TabViewNames.FirstOrDefault();
    var selectedShopImport = selectedShop != null && shopImports.ContainsKey(selectedShop.Id) ? shopImports[selectedShop.Id] : null;
    var currentTabModel = selectedShopImport.GetSettings(selectedTabView.Key);
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }    

    <script src="~/js/fileUpload.js"></script>

    <script src="~/js/settings.js"></script>


}


<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>

    <div class="flex">

        <div>
            <div class="left_menu">
                <h1 class="display-7 menu_item">Shops</h1>
            </div>
            <ul class="left-menu-ul" id="shopsList">
                @foreach (var shop in shops)
                {
                    <form name="shopForm" method="get" asp-action="Index" asp-controller="Home" asp-antiforgery="true"
                          asp-route-shopId="@shop.Id"
                          asp-route-tab="@((int)selectedTabView.Key)">
                    <li class="@ViewHelper.GetLiStyle(shop.Name,selectedShop.Name)">
                        <a onclick="saveTab($('#settingsForm'), ()=>{this.parentElement.parentElement.submit();}); ">@shop.Name</a>
                    </li>
                    </form>
                }
            </ul>
        </div>

        <div>
            <div class="menu" id="menuDiv">
                @foreach (var tab in ModelHelper.TabNames)
                {
                    <div class="@ViewHelper.GetMenuItemStyle(tab.Key,selectedTabName.Key)">
                        <form method="get" asp-action="Index" asp-controller="Home" asp-antiforgery="true"
                              asp-route-shopId="@selectedShop.Id"
                              asp-route-tab="@((int)tab.Key)">
                            <label class="display-7  menu_header" onclick="saveTab($('#settingsForm'), ()=>{ this.parentElement.submit();})">@tab.Value</label>
                        </form>
                    </div>
                }
            </div>
            <div id="settingsDiv">
                @await Html.PartialAsync($"~/Views/Home/{selectedTabView.Value}.cshtml", currentTabModel);
            </div>
        </div>
    </div>

</div>
