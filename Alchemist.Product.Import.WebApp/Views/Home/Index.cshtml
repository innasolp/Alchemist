@using Alchemist.Product.Import.WebApp.Infrastructure;

@inject List<ShopModel> shops;
@inject IReadOnlyCollection<string> tabs;
@inject IDictionary<int, ShopImportModel> shopImports;

@{
    ViewData["Title"] = "Home Page";
    var selectedShop = ViewData["Shop"] as ShopModel ?? shops.FirstOrDefault();
    var selectedTab = ViewData["Tab"] as string ?? tabs.FirstOrDefault();
    var selectedShopImport = selectedShop != null && shopImports.ContainsKey(selectedShop.Id) ? shopImports[selectedShop.Id] : null;
    var currentTab = TabFactory.GetSettings(selectedShopImport, selectedTab);
}

@functions
{   
    public string GetLiStyle(string item, string selectedItem) => "left-menu-ul" + (selectedItem == item ? " selected" : "");
    public string GetMenuItemStyle(string item, string selectedItem) => "menu_item" + (selectedItem == item ? " selected" : "");
}

<script>

function sendShopSelection(form)
   { 
       var settingsForm = document.getElementById('settingsForm');
       var settingsFormData = new FormData(settingsForm);
       addFormDataJson(settingsFormData);
       var newFormData = getFormDataPrefix(settingsFormData, 'prevSettings');
       appendFormData(form,newFormData);
       form.submit();
   }

</script>


<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>

    <div class="flex">

        <div>
            <div class="left_menu">
                <h1 class="display-7 menu_item">Shops</h1>
            </div>
            <ul class="left-menu-ul" id="shopsList">
                @foreach (var shop in shops)
                {
                    <form id="shopForm" method="post" asp-action="Index" asp-controller="Home" asp-antiforgery="true"
                          asp-route-shop.Name="@shop.Name"
                          asp-route-shop.Id="@shop.Id"
                          asp-route-tab="@selectedTab">
                        <li class="@GetLiStyle(shop.Name,selectedShop.Name)">
                        <a onclick="sendShopSelection(this.parentElement.parentElement);">@shop.Name</a>
                        </li>
                    </form>
                }
            </ul>
        </div>

        <div>
            <div class="menu" id="menuDiv">                
                @foreach (var tab in tabs)
                {
                    <div class="@GetMenuItemStyle(tab,selectedTab)">
                        <form method="post" asp-action="Index" asp-controller="Home" asp-antiforgery="true"
                              asp-route-shop.Name="@selectedShop.Name"
                              asp-route-shop.Id="@selectedShop.Id"
                              asp-route-tab="@tab">
                            <label class="display-7  menu_header" onclick="this.parentElement.submit();">@tab</label>
                        </form>
                    </div>
                }
            </div>
            <div id="settingsDiv">
                <form id="settingsForm" method="post" asp-action="@selectedTab" asp-controller="Home" asp-antiforgery="true">
                    <input type="hidden" name="ShopId" value="@selectedShop.Id"/>
                    <input type="hidden" name="SettingsType" value="@currentTab.Type" />
                    @await Html.PartialAsync(selectedTab, currentTab));
                </form>
                           
            </div>           
        </div>
    </div>

</div>
