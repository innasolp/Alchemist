@using System.Text.Json
@model CategoryUrlModel


<h4>Root category</h4>
<hr />
<div id="rootCategoryDiv" onload="setDivToForm($('#rootCategoryDiv'), $('#rootCategoryFormDiv'), 'rootCategoryForm');">

</div>
<form id="rootCategoryForm">
    <div class="row" id="rootCategoryFormDiv">
        <input type="hidden" name="ShopSettingsGuid" value="@Model.ShopSettingsGuid" id="RootCategoryShopSettingsGuid" />
        <input type="hidden" name="Guid" value="@Model.Guid" id="RootCategoryGuid" />
        <div class="col-md-4">
            <div class="flex">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Item" class="control-label"></label>
                    <input asp-for="Item" class="form-control rootCategoryItem" />
                    <span asp-validation-for="Item" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Url" class="control-label"></label>
                    <input asp-for="Url" class="form-control rootCategoryUrl"/>
                    <span asp-validation-for="Url" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button type="button" onclick="save($('#rootCategoryForm'), '/ShopSettings/RootCategory/Set',  getFormData($('#rootCategoryForm')), null, (data)=>{ if(data == null) return; $('#divRootCategoryModal').modal('hide'); setRootCategoryLi(data, $('#rootCategoriesUl'));  } );">
                        <i class="fa fa-check" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>




