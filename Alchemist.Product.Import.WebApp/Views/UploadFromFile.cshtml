@model UploadFromFileModel

<div>
    <input type="file" id="@Model.Id" style="display:none"
           name="@Model.Id"
           onchange="@Model.OnChangeWithFileNameLabel" />
    <button type="button" class="btn btn-primary form-button"
            onclick="$('#@Model.Id')[0].click();">
        @Model.ButtonLabel
    </button>
    <div id="@Model.LabelId" style="height:10px">
        <i>@(Model.FileName ?? "")</i>
    </div>
</div>
