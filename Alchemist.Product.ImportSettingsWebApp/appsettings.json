{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Clusters": {
      "shopCluster": {
        "Destinations": {
          "user": {
            "Address": "https://localhost:8401/"
          }
        }
      }
    },
    "Routes": {
      "shopRoute": {
        "ClusterId": "shopCluster",
        "Match": {
          "Path": "/ShopApi/{**catch-all}"
        }
      }
    }

  },
  "SettingsAPIHost": "https://$[localhost]:8201"
}
