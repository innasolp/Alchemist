@using System.Text.Json
@using Alchemist.Product.ImportSettingsWebApp.Controllers
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model PrimaryServiceModel


@functions{
    public object GetServiceData() => JsonSerializer.Serialize(new ServiceSettingsData { ShopSettingsType = (int)Model.ShopSettingType, ShopId = Model.ShopId, ServiceName = Model.Name });
    public string GetServiceUploadOnChange() => "setServiceSettingsFromJson($('#settingsForm'), this.name, '" + Model.Name + "', (data)=>{setValIfValid('#" + Model.Name + "', data.serviceTypeName); })";
}

<div class="flex">
    <div>
        <input class="form-control form-input @Model.ClassName" readonly="readonly" value="@Model.ServiceSettings?.ServiceTypeName"
               asp-for-model="@Model.Parent" model-property="@Model.Name" />
        <span asp-validation-for-model="@Model.Parent" model-property="@Model.Name" class="text-danger"></span>
    </div>
    <div class="flex control-group">
        <div>
            <button onclick="showServiceSettingsModal('/Import/Settings/@Model.Name', @GetServiceData(), (result)=>{ if(result) clearFileNameFromUploadControl('@(Model.Name)Json'); }  )"
                    class="btn btn-primary btn-sm form-button btn-set @Model.ClassName">
                Set
            </button>
        </div>
        <vc:upload-from-file id="@(Model.Name)Json"
                             on-change="@GetServiceUploadOnChange()"
                             file-name="@Model.ServiceSettings?.FileName"
                             class-name="@Model.ClassName"></vc:upload-from-file>
    </div>
</div>