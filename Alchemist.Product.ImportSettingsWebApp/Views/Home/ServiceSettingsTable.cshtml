@using Alchemist.Import.Settings.Extensions
@using System.Text.Json
@model ShopImportSettingsModel


<ul class="table-ul services">
    <li class="table-ul header">
        <div class="flex">
            <div class="table_header" style="width:200px">Name</div>
            <div class="table_header" style="width:200px">ServiceTypeName</div>
            <div></div>
        </div>
    </li>
    @foreach (var service in Model.Services.Where(s => !s.Key.IsPrimaryServiceName()))
    {
        <li class="table-ul service_li">
            <div class="flex serviceRow">
                <div class="table_cell name" style="width:200px">@service.Value.Name</div>
                <div class="table_cell serviceTypeName" style="width:200px">@service.Value.ServiceTypeName</div>
                <input type="hidden" class="guid" value="@service.Value.Guid" />
                <div>
                    <i class='fa fa-edit editService' style='font-size:18px'
                       onclick="showServiceSettingsModal('/ServiceSettings/', {'shopId': '@service.Value.ShopId', 'shopSettingsId':'@service.Value.ParentSettingsId', 'guid':'@service.Value.Guid' })"></i>
                </div>
            </div>
        </li>
    }
    <li class="table-ul">
        <div>
            <a class="addService"
               onclick="showServiceSettingsModal('/ServiceSettings/', {'ShopId': '@Model.ShopId', 'shopSettingsId':'@Model.Id' })">Add service</a>
        </div>
    </li>
</ul>

