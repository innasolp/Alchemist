@using System.Text.Json

@model CategoryUrlModel

<li class="table-ul rootcategory_li" id="@Model.Guid">
    <div class="flex rootCategoryRow">
        <div class="table_cell item">@Model.Item</div>
        <div class="table_cell url">@Model.Url</div>
        <div>
            <button type="button" class="editRootCategory" onclick="showCategoryUrlModal('@Model.Guid', @Model.ShopId)">
                <i class='fa fa-edit' style='font-size:18px'></i>
            </button>
        </div>
    </div>
</li>
