@using Alchemist.Import.Settings.Extensions
@using Microsoft.AspNetCore.Html
@using ShopSettings.Interfaces
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@functions{
    string Disabled(ShopSettingType shopSettingType) => Model.ShopSettingType == shopSettingType ? "disabled-link" : "";
    string Selected(ShopSettingType shopSettingType) => Model.ShopSettingType == shopSettingType ? "selected" : "";
}


@model IndexModel


<div class="flex">
    <div id="shopListDiv">
    </div>
    <div id="importSettingsTabDiv" style="width:100%">
        <div class="menu tabsMenuDiv">
            <div class="shop-tab menu_item-a">
                <a href="/Import/Settings/@Model.ShopId/@((int)ShopSettingType.Product)"
                   class="display-8 @Disabled(ShopSettingType.Product) menu_header @Selected(ShopSettingType.Product)">
                    @Enum.GetName(ShopSettingType.Product)
                </a>
            </div>
            <div class="shop-tab menu_item-a">
                <a href="/Import/Settings/@Model.ShopId/@((int)ShopSettingType.Category)"
                   class="display-8 @Disabled(ShopSettingType.Category) menu_header @Selected(ShopSettingType.Category)">
                    @Enum.GetName(ShopSettingType.Category)
                </a>
            </div>
        </div>
        
        <div id="importSettingsDiv">
            @await Html.PartialAsync("~/Views/Shared/ImportSettings.cshtml", ModelHelper.CreateShopImportSettingsModel(Model.ShopId ?? 0, Model.ShopSettingType))
        </div>
    </div>
</div>



