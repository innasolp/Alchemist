<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Configurations>Debug;Release;debug libs</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DependencyInjection.ImplementationFactory" Version="1.0.0" />
    <PackageReference Include="DependencyInjection.Interception" Version="1.0.0" />
    <PackageReference Include="Log.Interceptors.DependencyInjection" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="WebLoader.Interfaces" Version="1.0.0.1" />
    <PackageReference Include="WebLoader.Common" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alchemist.Import.Category.Interfaces\Alchemist.Import.Category.Interfaces.csproj" />
    <ProjectReference Include="..\Alchemist.Import.Common\Alchemist.Import.Common.csproj" />
    <ProjectReference Include="..\Alchemist.Import.Html\Alchemist.Import.Html.csproj" />
    <ProjectReference Include="..\Alchemist.Import.Service\Alchemist.Import.Service.csproj" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="set importDir=$(SolutionDir)\Import\Categories\Json&#xD;&#xA;if not exist &quot;%25importDir%25&quot; mkdir  &quot;%25importDir%25&quot;&#xD;&#xA;xcopy /E /Y  &quot;$(TargetDir)&quot; &quot;%25importDir%25&quot;" />
  </Target>

</Project>
