{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Clusters": {
      "shopCluster": {
        "Destinations": {
          "user": {
            "Address": "https://localhost:8401/"
          }
        }
      },
      "importSettingsCluster": {
        "Destinations": {
          "user": {
            "Address": "https://localhost:7083/"
          }
        }
      }
    },
    "Routes": {
      "shopRoute": {
        "ClusterId": "shopCluster",
        "Match": {
          "Path": "/ShopApi/{**catch-all}"
        }
      },
      "importSettingsRoute": {
        "ClusterId": "importSettingsCluster",
        "Match": {
          "Path": "/ImportSettingsApi/{**catch-all}"
        }
      }
    }

  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    },
    "EndPoints": {
      "Http": {
        "Url": "http://+:7100"
      },
      "Https": {
        "Url": "https://+:7101"
      }
    }
  }
}
