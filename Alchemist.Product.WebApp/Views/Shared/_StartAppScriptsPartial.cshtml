@model IndexModel

@functions
{
    string[] GetScriptFiles()
    {
        switch(Model.Tab)
        {
            case Tab.Shop:
                return ["shopapp.js", "shop.js"];

            default:
                return [];
        }
    }
}

@foreach(var scriptFile in GetScriptFiles())
{
    <script src="~/js/@scriptFile" asp-append-version="true"></script>
}

