@model IndexModel

@functions
{
    string[] GetScriptFiles()
    {
        switch(Model.Tab)
        {
            case Tab.Shop:
                return ["shopapp/shop.app.js"];

                case Tab.ImportSettings:
                return ["importsettingsapp/importsettings.app.js"];

            default:
                return [];
        }
    }
}

@foreach(var scriptPath in GetScriptFiles())
{
    <script src="~/lib/@scriptPath" asp-append-version="true"></script>
}

