@using System.Text.Json
@using Microsoft.AspNetCore.Html
@model IndexModel

@{
    ViewData["Title"] = "Home Page";
}

@functions{
    string Disabled(Tab tab) => Model.Tab == tab ? "disabled-link" : "";
    string Selected(Tab tab) => Model.Tab == tab ? "selected" : "";    
    HtmlString GetData()
    {
        {
            var serializeOptions = new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
                WriteIndented = true // Optional: for pretty-printed JSON
            };
            return new HtmlString(@JsonSerializer.Serialize(Model.Data, serializeOptions));
        }
    }

}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        await Html.RenderPartialAsync("_StartAppScriptsPartial");
    }

    <script>
        init('@Model.Tab.ToString()', '@Model.AppName', @GetData()) ;
    </script>
}

<tab-panel class="menu tabsMenuDiv">
    <tab-item class="tab-item" data-item="shops" content="@Enum.GetName(Tab.Shop)" action="#"></tab-item>
    <tab-item class="tab-item" data-item="importSettings" content="@Enum.GetName(Tab.ImportSettings)" action="#"></tab-item>
</tab-panel>
<div id="appDiv"></div>