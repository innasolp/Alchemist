{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    },
    "EndPoints": {
      "Http": {
        "Url": "http://+:8070",
        "Protocols": "Http2"
      },
      "Https": {
        "Url": "https://+:8071",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "DbContext": "Username=postgres;Password=P@ssw0rd;Server=$[localhost];Database=alchemy;Port=5432;",
    "DbContext2": "Username=pguser;Password=p@ssw0rd;Server=$[localhost];Database=alchemy;Port=5432;",
    "RedisStore": "127.0.0.1:6379,user=default,password=passw0rd,abortConnect=false,syncTimeout=10000,connectTimeout=15000,keepAlive=5"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Information",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
        "Microsoft.AspNetCore": "Information"
      }
