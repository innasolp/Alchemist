<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BrowserDataLoader.Firefox.Standart.Windows" Version="1.0.0.3" GeneratePathProperty="true" />
		<PackageReference Include="WebLoader.HttpClient" Version="1.0.0.6" />
		<PackageReference Include="WebLoader.Playwright.Firefox" Version="1.0.0.8" GeneratePathProperty="true" />
		<PackageReference Include="BrowserLauncher.Firefox.Windows.Standart" Version="1.0.0.1" GeneratePathProperty="true" />
	</ItemGroup>

	<Target Name="RemoveBrowserDataLoaderDir" BeforeTargets="Build">
		<RemoveDir Directories="$(SolutionDir)Libs\BrowserDataLoader" />
	</Target>

	<Target Name="RemoveBrowserDataLoaderFirefoxDir" BeforeTargets="Build">
		<RemoveDir Directories="$(SolutionDir)Libs\BrowserDataLoader\Firefox\Standart" />
	</Target>

	<Target Name="CopyBrowserDataLoaderFirefox" AfterTargets="Build">
		<ItemGroup>
			<BrowserDataLoaderFirefoxFiles Include="$(PkgBrowserDataLoader_Firefox_Standart_Windows)\lib\dependencies\*.dll"></BrowserDataLoaderFirefoxFiles>
			<CopyBrowserDataLoaderNativeFiles Include="$(PkgBrowserDataLoader_Firefox_Standart_Windows)\lib\dependencies\**\*.*"></CopyBrowserDataLoaderNativeFiles>
		</ItemGroup>
		<Copy SourceFiles="@(BrowserDataLoaderFirefoxFiles)" DestinationFolder="$(SolutionDir)Libs\BrowserDataLoader\Firefox\Standart"></Copy>
		<Copy SourceFiles="@(CopyBrowserDataLoaderNativeFiles)" DestinationFolder="$(SolutionDir)Libs\BrowserDataLoader\Firefox\Standart\%(RecursiveDir)"></Copy>
	</Target>

	<Target Name="RemoveBrowserLauncherDir" BeforeTargets="Build">
		<RemoveDir Directories="$(SolutionDir)Libs\BrowserLauncher" />
	</Target>

	<Target Name="RemoveBrowserLauncherFirefoxDir" BeforeTargets="Build">
		<RemoveDir Directories="$(SolutionDir)Libs\BrowserLauncher\Firefox\Standart" />
	</Target>

	<Target Name="CopyBrowserLauncherFirefox" AfterTargets="Build">
		<ItemGroup>
			<BrowserLauncherFirefoxFiles Include="$(PkgBrowserLauncher_Firefox_Windows_Standart)\lib\dependencies\*.dll"></BrowserLauncherFirefoxFiles>
		</ItemGroup>
		<Copy SourceFiles="@(BrowserLauncherFirefoxFiles)" DestinationFolder="$(SolutionDir)Libs\BrowserLauncher\Firefox\Standart"></Copy>
	</Target>

	<Target Name="RemoveWebLoaderDir" BeforeTargets="Build">
		<RemoveDir Directories="$(SolutionDir)Libs\WebLoader" />
	</Target>

	<Target Name="RemoveWebLoaderHttpClientDir" BeforeTargets="Build">
		<RemoveDir Directories="$(SolutionDir)Libs\WebLoader\HttpClient" />
	</Target>
	

	<Target Name="RemoveWebLoaderPlaywrightFirefoxDir" BeforeTargets="Build">
		<RemoveDir Directories="$(SolutionDir)Libs\WebLoader\Playwright\Firefox" />
	</Target>

	<Target Name="CopyWebLoaderPlaywrightFirefox" AfterTargets="Build">
		<ItemGroup>
			<CopyWebLoaderPlaywrightFirefoxFiles Include="$(PkgWebLoader_Playwright_Firefox)\dependencies\*.dll"></CopyWebLoaderPlaywrightFirefoxFiles>
			<CopyFirefoxPlaywrightFiles Include="$(PkgWebLoader_Playwright_Firefox)\dependencies\.playwright\**\*.*"></CopyFirefoxPlaywrightFiles>
			<CopyFirefoxPlaywrightNodeFiles Include="$(PkgWebLoader_Playwright_Firefox)\dependencies\node\**\*.*"></CopyFirefoxPlaywrightNodeFiles>
			<CopyFirefoxPlaywrightPackageFiles Include="$(PkgWebLoader_Playwright_Firefox)\dependencies\package\**\*.*"></CopyFirefoxPlaywrightPackageFiles>
		</ItemGroup>
		<Copy SourceFiles="@(CopyWebLoaderPlaywrightFirefoxFiles)" DestinationFolder="$(SolutionDir)Libs\WebLoader\Playwright\Firefox"></Copy>
		<Copy SourceFiles="@(CopyFirefoxPlaywrightFiles)" DestinationFolder="$(SolutionDir)Libs\WebLoader\Playwright\Firefox\.playwright\%(RecursiveDir)"></Copy>
		<Copy SourceFiles="@(CopyFirefoxPlaywrightNodeFiles)" DestinationFolder="$(SolutionDir)Libs\WebLoader\Playwright\Firefox\.playwright\node\%(RecursiveDir)"></Copy>
		<Copy SourceFiles="@(CopyFirefoxPlaywrightPackageFiles)" DestinationFolder="$(SolutionDir)Libs\WebLoader\Playwright\Firefox\.playwright\package\%(RecursiveDir)"></Copy>
	</Target>

</Project>
