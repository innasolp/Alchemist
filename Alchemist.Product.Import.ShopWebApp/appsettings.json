{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    },
    "EndPoints": {
      "Http": {
        "Url": "http://+:8400"
      },
      "Https": {
        "Url": "https://+:8401"
      }
    }
  },
  "ShopAPIHost": "https://$[localhost]:8051"
}
