@using Alchemist.Product.ShopWebApp.Models

@model IndexModel

@{
    ViewData["Title"] = "Home Page";
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }    
       
    @if(!Model.ShopsUploaded)
    {
        <script>uploadShopTab($('#shopsTab'), null, setItemsPreventClick);</script>
    }
    else
    {
        <script>
            $(()=>setItemsPreventClick());
        </script>
    }    
}

<div id="shopsTab">
    @await Html.PartialAsync($"~/Views/Shared/ShopTab.cshtml", Model.ShopTab);   
</div>
