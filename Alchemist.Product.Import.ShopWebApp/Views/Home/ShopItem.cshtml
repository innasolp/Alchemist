@model ShopItemModel

@functions{
    string GetSelected() => Model.IsSelected ? "selected" : "";
}

<div class="flex">
    <a href="@Model.HRef"
       class='shop_item @GetSelected()'
    style="width:250px">@Model.ShopModel.Name</a>
</div>
