@using Alchemist.Product.ShopWebApp.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<ShopItemModel>

<ul class="left-menu-ul shopsList">   
    @foreach (var shopItem in Model)
    {
        <li class="left-menu-ul">
            @await Html.PartialAsync("~/Views/Home/ShopItem.cshtml", shopItem)
        </li>
    }
</ul>
