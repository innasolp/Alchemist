@model IndexModel

<div class="flex">
    <div>
        <ul class="left-menu-ul shopsList">
            <li class="left-menu-ul">
                <a id="createNewShop" href="/Shop/New" >Новый</a>
            </li>
            <li class="left-menu-ul">
                <div id="shopList">
                    @await Html.PartialAsync($"~/Views/Shared/ShopList.cshtml", new List<ShopItemModel>())
                </div>
            </li>
        </ul>
    </div>
    <div style="width:100%" id="shopDiv">
        @await Html.PartialAsync($"~/Views/Home/ShopEdit.cshtml", new ShopModel())
    </div>
</div>
