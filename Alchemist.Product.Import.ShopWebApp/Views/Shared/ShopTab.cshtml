@using Alchemist.Product.ShopWebApp.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model ShopTabModel

<div class="flex">
    <div>
        <ul class="left-menu-ul shopsList">
            <li class="left-menu-ul">
                <a id="createNewShop" asp-controller="Shop" asp-action="New" >Новый</a>
            </li>
            <li class="left-menu-ul">
                @await Html.PartialAsync($"~/Views/Shared/ShopList.cshtml", Model.ShopItems)
            </li>
        </ul>
    </div>
    <div style="width:100%">
        @await Html.PartialAsync($"~/Views/Home/ShopEdit.cshtml", Model.CurrentShopModel)
    </div>
</div>
