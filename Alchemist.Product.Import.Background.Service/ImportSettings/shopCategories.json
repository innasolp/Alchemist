{
  "OzonCategories": {
    "ShopName": "Ozon",
    "Caption": "Ozon",
    "ShopUrl": "https://www.ozon.ru",
    "CategorySourceUrl": "https://www.ozon.ru",
    "Perfomance": true,
    "Services": {
      "ImportService": {
        "ImplementationTypeName": "ShopImportCategoriesJsonTimerService",
        "AssemblyPath": "Import\\Categories\\Json",
        "ServiceProviderPath": "Import\\Categories\\Json"
      },
      "WebLoader": {
        "ImplementationTypeName": "Chromium",
        "AssemblyPath": "Libs\\webLoader\\Playwright\\ChromiumPatchright"
      },
      "HostRequestOptions": {
        "Value": {
          "RouteUrlFormat": "https://www.ozon.ru/api/entrypoint-api.bx/page/json/v2?url=%2FsearchSuggestions"
        }
      },
      "CategoryLoadOptions": {
        "ServiceTypeName": "CategoryLoadOptions",
        "AssemblyPath": "Import\\Categories\\Json",
        "Value": {
          "HtmlSearchOptions": {
            "Tag": "div",
            "SearchString": "id=state-catalogMenu",
            "ValueString": "data-state"
          },
          "FirstNodePath": [ "data", "columns", "categories" ],
          "CategoriesApiUrlFormat": "https://www.ozon.ru/api/composer-api.bx/_action/v2/categoryChildV3?menuId=185&categoryId={0}",
          "SecondsInterval": 1800,
          "CategoryPropertyPaths": {
            "Url": {
              "PropertyName": "Url",
              "Path": "url"
            },
            "Description": {
              "PropertyName": "Description",
              "Path": "title"
            },
            "Children": {
              "PropertyName": "Children",
              "Path": "categories"
            }
          }
        }
      },
      "HtmlSearchFactoryOptions": {
        "ServiceTypeName": "HtmlSearchFactoryOptions",
        "AssemblyPath": "Import\\Html",
        "Value": {
          "SearchMatchType": 1,
          "SearchElementType": 0
        }
      },
      "IHtmlSearcher": {
        "ServiceTypeName": "IHtmlSearcher",
        "AssemblyPath": "Import\\Html",
        "ServiceProviderPath": "Import\\Html"
      }
    }
    },

  "GoldAppleCategories": {
    "ShopName": "Goldapple",
    "ShopUrl": "https://goldapple.ru",
    "CategorySourceUrl": "https://goldapple.ru",
    "Caption": "Золотое яблоко",
    "Perfomance": true,
    "Services": {
      "ImportService": {
        "ImplementationTypeName": "ShopImportCategoriesJsonTimerService",
        "AssemblyPath": "Import\\Categories\\Json",
        "ServiceProviderPath": "Import\\Categories"

      },
      "WebLoader": {
        "ImplementationTypeName": "Chromium",
        "AssemblyPath": "Libs\\webLoader\\Playwright\\ChromiumPatchright"
      },
      "HostRequestOptions": {
        "Value": {
          "RouteUrlFormat": "https://goldapple.ru/front/api/apm/events"
        }
      },
      "RequestOptions": {
        "Value": {
          "RouteUrlFormat": "https://goldapple.ru/web/api/v3/catalog/navigation"
        }
      },
      "CategoryLoadOptions": {
        "ServiceTypeName": "CategoryLoadOptions",
        "AssemblyPath": "Import\\Categories\\Json",
        "Value": {
          "FirstNodePath": [ "data", "general" ],
          "SecondsInterval": 1800,
          "CategoryPropertyPaths": {
            "Url": {
              "PropertyName": "Url",
              "Path": "link"
            },
            "Description": {
              "PropertyName": "Description",
              "Path": "name"
            },
            "Children": {
              "PropertyName": "Children",
              "Path": "children"
            },
            "Id": {
              "PropertyName": "Id",
              "Path": "id"
            }
          }
        }
      }
    }
  }
}