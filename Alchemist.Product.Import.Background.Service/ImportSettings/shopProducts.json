    "ShopUrl": "https://goldapple.ru",
    "ProductUrlFormat": "https://goldapple.ru{0}",
    "CategoryUrlFormat": "https://goldapple.ru{0}?p={1}",
    "PageProductCount": 20,
    "Perfomance": true,
    "RootCategories": [
      {
        "Item": 1000000004,
        "Url": "/uhod/"
      }
    ],
    "Services": {
      "ImportService": {
        "ImplementationTypeName": "ShopImportHttpJsonCategoryProductsService",
        "AssemblyPath": "Import\\Products\\Json"
      },
      "WebLoader": {
        "ImplementationTypeName": "Chromium",
        "AssemblyPath": "Libs\\webLoader\\Playwright\\ChromiumPatchright"
      },
      "ItemHandler": {
        "ImplementationTypeName": "BeautyAndHealthProduct"
      },
      "ProductJsonSettings": {
        "AssemblyPath": "ImportSettings/goldapple.product.settings.json"
      },
      "CategoryJsonSettings": {
        "AssemblyPath": "ImportSettings/goldapple.category.settings.json"
      },
      "CategoryRequestOptions": {
        "Value": {
          "RouteUrlFormat": "https://goldapple.ru/front/api/catalog/cards-list"
        }
      },
      "ProductRequestOptions": {
        "Value": {
          "RouteUrlFormat": "https://goldapple.ru/front/api/catalog/product-card/base/v3"
        }
      },
      "HostRequestOptions": {
        "Value": {
          "RouteUrlFormat": "https://goldapple.ru/front/api/apm/events",
          "LoadingType" : "Route"
        }
      }
    }
  }
}