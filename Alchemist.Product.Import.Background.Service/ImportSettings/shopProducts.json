{
  "OzonProductsImport": {
    "ShopName": "Ozon",
    "Caption": "Ozon",
    "ShopUrl": "https://www.ozon.ru",
    "ProductUrlFormat": "https://www.ozon.ru/api/entrypoint-api.bx/page/json/v2?url={0}%26layout_container%3DpdpPage2column%26layout_page_index%3D2",
    "ProductUrlFormatType": "Path",
    "CategoryUrlFormat": "https://www.ozon.ru/api/entrypoint-api.bx/page/json/v2?url={0}",
    "CategoryUrlFormatType": "Path",
    "Perfomance": true,
    "PageProductCount": 12,
    "RootCategories": [
      {
        "Item": 6500,
        "Url": "/category/krasota-i-zdorove-6500/"
      }
    ],
    "Services": {
      "ImportService": {
        "ImplementationTypeName": "ShopImportHttpJsonPaginatorCategoryProductsService",
        "AssemblyPath": "Import\\Products\\Json"
      },
      "WebLoader": {
        "ImplementationTypeName": "ChromiumPatchright",
        "AssemblyPath": "Libs\\webLoader\\Playwright\\ChromiumPatchright",
        "ServiceProviderPath": "Libs\\webLoader\\Playwright\\ChromiumPatchright"
      },
      "ItemHandler": {
        "ImplementationTypeName": "BeautyAndHealthProduct"
      },
      "ProductJsonSettings": {
        "AssemblyPath": "ImportSettings/ozon.product.settings.json"
      },
      "CategoryJsonSettings": {
        "AssemblyPath": "ImportSettings/ozon.category.settings.json"
      },
      "HostRequestOptions": {
        "Value": {
          "RouteUrlFormat": "https://www.ozon.ru/api/entrypoint-api.bx/page/json/v2?url=%2FsearchSuggestions",
          "LoadingType": "WaitForUrl"
        }
      },
      "CategoryRequestOptions": {
        "Value": {
          "LoadingType": "Simple",
          "TimeouteMillseconds" : 3000
        }
      },
      "ProductRequestOptions": {
        "Value": {
          "LoadingType": "Api"
        }
      },
      "RateLimiterOptions": {
        "Value": {
          "WindowMilliseconds": 5000
        }
      }
    }
  },

  "GoldAppleProductsImport": {
