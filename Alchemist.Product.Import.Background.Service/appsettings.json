{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ServicesStoreRedis": "127.0.0.1:6379,user=default,password=passw0rd,abortConnect=false,syncTimeout=10000,connectTimeout=15000,keepAlive=5"
  },
  "HttpPort": 8130,
  "HttpsPort": 8131,
  "WebLoaderPath": "Libs\\WebLoader",
  "ShopImportServiceStatePath": "Import\\ServiceState",
  "ShopProductImportPath": "Import\\Products",
  "ShopCategoryImportPath": "Import\\Categories\\Services",
  "ShopCategoryLoadersPath": "Import\\Categories\\Services\\Loaders",
  "AllowedHosts": "*",
  "BrowserServiceHost": "https://$[localhost]:8301",
  "RestAPIHost": "https://$[localhost]:8051",
  "GrpcAPIHost": "https://$[localhost]:8071",
  "SettingsAPIHost": "https://$[localhost]:8201",
  "SignalRImportUrl": "https://$[localhost]:8101/import",
  "SignalREventsUrl": "https://$[localhost]:8101/events",
  "RabbitMqServiceOptions": {
    "HostName": "$[localhost]",
    "Port": 5672
  },
  "RabbitMqQueueOptions": {
    "Name": "shop.import.queue"
  },
  "RabbitMqExchangeOptions": {
    "ExchangeName": "items"
  },
  "RabbitMQProductEvent": "product",
  "RabbitMQCategoryEvent": "category",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    },
    "EndPoints": {
      "Http": {
        "Url": "http://+:8130"
      },
      "Https": {
        "Url": "https://+:8131"
      }
    }
  },
  "HangfireJobExecuteOptions": {
    "ServerName": "ShopImportServer",
    "WaitingQueue": "waiting",
    "ProcessingQueue": "executing"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    },
    "Using": [ "Serilog.ContextFileSink" ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithThreadName" ],
    "Properties": {
      "Application": "Alchemist.ImportWorkerService"
    }
  }
}
